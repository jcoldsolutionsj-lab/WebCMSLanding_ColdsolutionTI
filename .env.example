# Cloudflare Turnstile Site Key (Clave del sitio pública)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_turnstile_site_key_aqui

# Google Tag Manager (ID de contenedor proporcionado por el equipo de analítica)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
