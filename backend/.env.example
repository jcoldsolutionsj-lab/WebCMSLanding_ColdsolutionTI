# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/cold_solutions

# Entorno (development o production)
ENVIRONMENT=development

# Cloudflare Turnstile (Secret Key del panel de Cloudflare)
TURNSTILE_SECRET_KEY=tu_turnstile_secret_key_aqui

# Dominios permitidos para CORS (separados por coma si son varios)
ALLOWED_ORIGINS=http://localhost:3000,https://coldsolutionsti.com,https://www.coldsolutionsti.com

# Integración Webhook n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads
N8N_WEBHOOK_TOKEN=tu_token_secreto_n8n
